# Firebase web app config (Firebase console > Project settings > Your apps)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account (Project settings > Service accounts). Server only.
NUXT_FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences in the key, wrapped in double quotes
NUXT_FIREBASE_PRIVATE_KEY=

# Encrypts AI provider API keys at rest. Generate with: openssl rand -base64 32
NUXT_ENCRYPTION_KEY=
